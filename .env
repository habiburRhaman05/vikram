# GoHighLevel / LeadConnector inbound webhook that the home page's lead
# popup (src/components/common/LeadPopup.jsx) posts to on submit. Committed
# (not .env.local) so every build - local or CI - ships with it; Vite
# inlines VITE_-prefixed vars into the client bundle at build time either
# way, so keeping it out of git would only mean silently losing leads on
# any build that doesn't happen to have a local copy of this file.
VITE_LEAD_WEBHOOK_URL=https://services.leadconnectorhq.com/hooks/fF6CHXWPpn5wTiMZjc7x/webhook-trigger/346679b2-9428-41d4-ab1d-3b62dfe34df9

# The consultation form on every service page, blog post and case study
# (src/components/services/ServiceEnquiryForm.jsx). Its own trigger on the
# same LeadConnector location as the popup above, so consultation requests
# and popup leads can be worked as two separate workflows. Committed for
# the same reason the one above is.
VITE_CONSULT_WEBHOOK_URL=https://services.leadconnectorhq.com/hooks/fF6CHXWPpn5wTiMZjc7x/webhook-trigger/ade2268b-a681-4bc6-9401-1199aa5a3abf

# The timed lead popup (src/components/common/LeadPopup.jsx). Its own
# trigger on the same LeadConnector location, so popup leads and
# consultation requests are two separate workflows. Committed for the same
# reason the one at the top of this file is.
VITE_POPUP_WEBHOOK_URL=https://services.leadconnectorhq.com/hooks/fF6CHXWPpn5wTiMZjc7x/webhook-trigger/0d368622-1059-42d7-acd4-c920902b4e49
