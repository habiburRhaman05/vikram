# GoHighLevel / LeadConnector inbound webhook that the home page's lead
# popup (src/components/common/LeadPopup.jsx) posts to on submit. Committed
# (not .env.local) so every build - local or CI - ships with it; Vite
# inlines VITE_-prefixed vars into the client bundle at build time either
# way, so keeping it out of git would only mean silently losing leads on
# any build that doesn't happen to have a local copy of this file.
VITE_LEAD_WEBHOOK_URL=https://services.leadconnectorhq.com/hooks/fF6CHXWPpn5wTiMZjc7x/webhook-trigger/346679b2-9428-41d4-ab1d-3b62dfe34df9
